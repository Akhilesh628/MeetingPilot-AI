
# Build stage
FROM maven:3.9-eclipse-temurin-21 AS build

WORKDIR /app

COPY pom.xml .
COPY calendar-mcp-server/pom.xml calendar-mcp-server/pom.xml
COPY meeting-agent/pom.xml meeting-agent/pom.xml

COPY calendar-mcp-server/src calendar-mcp-server/src

RUN mvn -B -pl calendar-mcp-server -am clean package -DskipTests

# Runtime stage
FROM eclipse-temurin:21-jre

WORKDIR /app

COPY --from=build /app/calendar-mcp-server/target/*.jar app.jar

EXPOSE 8082

ENTRYPOINT ["java", "-jar", "app.jar"]
