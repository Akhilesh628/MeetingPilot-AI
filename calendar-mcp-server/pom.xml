    <artifactId>calendar-mcp-server</artifactId>
    <name>Calendar MCP Server</name>

    <dependencies>

        <!-- MCP Server using Streamable HTTP -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

